# start.ps1 — {{PROJECT_NAME}} 一鍵啟動後端 + 前端
# 用法：.\scripts\start.ps1

. "$PSScriptRoot\env.ps1"
$root = Split-Path $PSScriptRoot -Parent
Set-Location $root

Write-Host "啟動 Spring Boot（:{{BACKEND_PORT}}）..." -ForegroundColor Cyan
Start-Process powershell -ArgumentList "-NoExit", "-Command", "cd '$root'; .\gradlew.bat bootRun"

Start-Sleep -Seconds 8

$frontendDir = Join-Path $root "{{FRONTEND_DIR}}"
if (Test-Path $frontendDir) {
    Write-Host "啟動 Vue 前端（:{{FRONTEND_PORT}}）..." -ForegroundColor Cyan
    Start-Process powershell -ArgumentList "-NoExit", "-Command", "cd '$frontendDir'; if (-not (Test-Path node_modules)) { npm install }; npm run dev"
}

Write-Host "`n========== {{PROJECT_NAME}} 使用連結 ==========" -ForegroundColor Green
Write-Host "【後端 :{{BACKEND_PORT}}】"
Write-Host "  健康檢查     http://localhost:{{BACKEND_PORT}}/actuator/health"
Write-Host "  應用資訊     http://localhost:{{BACKEND_PORT}}/actuator/info"
Write-Host "  Swagger UI   http://localhost:{{BACKEND_PORT}}/swagger-ui.html"
Write-Host "  OpenAPI JSON http://localhost:{{BACKEND_PORT}}/v3/api-docs"
Write-Host "  H2 Console   http://localhost:{{BACKEND_PORT}}/h2-console"
Write-Host "  H2 JDBC URL  {{H2_JDBC}}  (sa / 空白密碼)"
Write-Host "【前台 :{{FRONTEND_PORT}}】"
Write-Host "  登入頁       {{LOGIN_URL}}"
Write-Host "  主頁         http://localhost:{{FRONTEND_PORT}}{{HOME_PATH}}"
Write-Host "  預設帳號     {{DEFAULT_USER}} / {{DEFAULT_PASS}}"
Write-Host "=========================================="
