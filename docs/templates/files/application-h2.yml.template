# application.yml 片段範本（H2 開發環境）
# 複製到新專案 src/main/resources/application.yml

server:
  port: {{BACKEND_PORT}}

spring:
  datasource:
    url: {{H2_JDBC}}
    username: {{H2_USER}}
    password: {{H2_PASSWORD}}
    driver-class-name: org.h2.Driver
  jpa:
    hibernate:
      ddl-auto: update
  h2:
    console:
      enabled: true
      path: /h2-console

# H2 Console 登入：
#   URL      http://localhost:{{BACKEND_PORT}}/h2-console
#   JDBC URL {{H2_JDBC}}
#   User     {{H2_USER}}
#   Password （空白，勿填 ~/test 預設值）
