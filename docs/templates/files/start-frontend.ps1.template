# start-frontend.ps1 — {{PROJECT_NAME}} 只啟動 Vue 前端
# 用法：.\scripts\start-frontend.ps1

$root = Split-Path $PSScriptRoot -Parent
$frontendDir = Join-Path $root "{{FRONTEND_DIR}}"
Set-Location $frontendDir

if (-not (Test-Path "node_modules")) {
    Write-Host "首次執行，安裝 npm 依賴..." -ForegroundColor Yellow
    npm install
}

Write-Host ""
Write-Host "========== {{PROJECT_NAME}} 前端 ==========" -ForegroundColor Cyan
Write-Host "登入頁    : {{LOGIN_URL}}"
Write-Host "主頁      : http://localhost:{{FRONTEND_PORT}}{{HOME_PATH}}"
Write-Host "預設帳號  : {{DEFAULT_USER}} / {{DEFAULT_PASS}}"
Write-Host "（後端需同時運行於 :{{BACKEND_PORT}}）"
Write-Host "=========================================="
Write-Host ""

npm run dev
